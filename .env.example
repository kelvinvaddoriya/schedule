# Copy to .env and fill in. See SETUP.md for where each value comes from.

# --- Claude (parses messages into plan changes) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any random string; you'll paste the same value into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v23.0

# Approved message templates, used for summaries/reminders when you haven't messaged
# the bot in the last 24 hours. Leave empty to skip those messages instead.
WHATSAPP_SUMMARY_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE=
# WHATSAPP_TEMPLATE_LANG=en

# --- App ---
# Timezone new users start with (they can change it by chatting).
DEFAULT_TIMEZONE=Asia/Kolkata
# Public URL of this server, used for the week-view link.
PUBLIC_URL=
# Comma-separated phone numbers (with country code) allowed to use the bot. Empty = anyone.
ALLOWED_NUMBERS=
# PORT=3000
# DATABASE_PATH=data/schedule.db
