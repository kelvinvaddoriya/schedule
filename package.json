{
  "name": "schedule",
  "version": "1.0.0",
  "description": "A WhatsApp weekly planner: text it your week, get back a realistic schedule.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "sim": "tsx src/simulator.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelvinvaddoriya/schedule.git"
  },
